{
  "name": "vite-plugin-preact-progressive",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "Jacob Ebey <jacob.ebey@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacob-ebey/preact-progressive.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "docgen": "tsdoc --noemoji --types --src=src/vite.ts --dest=./docs/vite.md"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "babel-plugin-preact-progressive": "workspace:*"
  },
  "devDependencies": {
    "@babel/types": "catalog:",
    "@tsconfig/node-ts": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "preact": "catalog:",
    "tsdoc-markdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
