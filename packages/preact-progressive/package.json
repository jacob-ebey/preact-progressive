{
  "name": "preact-progressive",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "Jacob Ebey <jacob.ebey@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacob-ebey/preact-progressive.git",
    "directory": "packages/preact-progressive"
  },
  "files": [
    "dist",
    "docs",
    "src"
  ],
  "type": "module",
  "sideEffects": true,
  "exports": {
    "./client": "./dist/client.mjs",
    "./decoder": "./dist/decoder.mjs",
    "./encoder": "./dist/encoder.mjs",
    "./router": "./dist/router.mjs",
    "./server": "./dist/server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "docgen": "tsdoc --noemoji --types --src=src/client.ts --dest=./docs/client.md && tsdoc --noemoji --types --src=src/decoder.ts --dest=./docs/decoder.md && tsdoc --noemoji --types --src=src/encoder.ts --dest=./docs/encoder.md && tsdoc --noemoji --types --src=src/router.ts --dest=./docs/router.md && tsdoc --noemoji --types --src=src/server.ts --dest=./docs/server.md",
    "test": "vp test"
  },
  "dependencies": {
    "preact-root-fragment": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "preact": "catalog:",
    "preact-render-to-string": "catalog:",
    "tsdoc-markdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "peerDependencies": {
    "preact": "*",
    "preact-render-to-string": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
