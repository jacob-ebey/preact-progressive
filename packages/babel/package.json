{
  "name": "babel-plugin-preact-progressive",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "Jacob Ebey <jacob.ebey@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacob-ebey/preact-progressive.git",
    "directory": "packages/babel"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./client": "./dist/client.mjs",
    "./server": "./dist/server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "docgen": "tsdoc --noemoji --types --src=src/client.ts --dest=./docs/client.md && tsdoc --noemoji --types --src=src/server.ts --dest=./docs/server.md",
    "test": "vp test"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/types": "catalog:",
    "@tsconfig/node-ts": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "preact": "catalog:",
    "tsdoc-markdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
